{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Platforms Registry v1.0",
  "type": "object",
  "required": ["schema_version", "plugin_id", "platforms"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "plugin_id": { "type": "string", "minLength": 3 },
    "default_retention": { "type": "integer", "minimum": 1 },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "display_name", "enabled", "phase_target", "phase_status", "adapter", "output_dir"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "display_name": { "type": "string", "minLength": 1 },
          "enabled": { "type": "boolean" },
          "phase_target": { "type": "string" },
          "phase_status": { "type": "string" },
          "adapter": { "type": "string", "pattern": "^.+:.+$" },
          "output_dir": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
