{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Unified Geospatial Engine & Technology Capability Profile Registry v1.0",
  "type": "object",
  "required": [
    "schema_version",
    "registry_id",
    "catalog_ref",
    "taxonomy_ref",
    "profile_count",
    "profiles",
    "non_github_official_docs",
    "engineering_tools_catalog"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "registry_id": { "type": "string", "const": "engine-capability-profiles" },
    "catalog_ref": { "type": "string", "const": "references/project-catalog.json" },
    "taxonomy_ref": { "type": "string", "const": "references/engine-capability-taxonomy.json" },
    "profile_count": { "type": "integer", "minimum": 1 },
    "non_github_official_docs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["doc_id", "name", "official_url", "category", "license_model", "notes"],
        "properties": {
          "doc_id": { "type": "string", "minLength": 2 },
          "name": { "type": "string", "minLength": 1 },
          "official_url": { "type": "string", "pattern": "^https?://" },
          "category": { "type": "string" },
          "license_model": { "type": "string" },
          "notes": { "type": "string" }
        }
      }
    },
    "engineering_tools_catalog": {
      "type": "array",
      "minItems": 45,
      "items": {
        "type": "object",
        "required": ["tool_id", "name", "category", "license", "optional_unbundled", "purpose"],
        "properties": {
          "tool_id": { "type": "string", "minLength": 2 },
          "name": { "type": "string", "minLength": 1 },
          "category": { "type": "string" },
          "license": { "type": "string" },
          "optional_unbundled": { "type": "boolean", "const": true },
          "installed_by_default": { "type": "boolean", "const": false },
          "project_id": { "type": ["string", "null"] },
          "official_url": { "type": "string" },
          "purpose": { "type": "string" }
        }
      }
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "profile_id",
          "project_id",
          "name",
          "entity_type",
          "primary_role",
          "secondary_roles",
          "platforms",
          "languages",
          "build_models",
          "integration_patterns",
          "capabilities",
          "relationships",
          "verification_metadata"
        ],
        "properties": {
          "profile_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "project_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "name": { "type": "string", "minLength": 1 },
          "entity_type": {
            "type": "string",
            "enum": [
              "Application",
              "Engine",
              "Core",
              "Kernel",
              "Library",
              "Framework",
              "Renderer",
              "Graphics API",
              "SDK",
              "API",
              "Runtime",
              "Binding/Wrapper",
              "Adapter",
              "Plugin/Add-in",
              "Fork",
              "Starter/Template",
              "Reference application",
              "CLI",
              "Service",
              "Algorithm/Recipe",
              "Model",
              "Standard/Format",
              "Asset",
              "Package/Distribution"
            ]
          },
          "primary_role": { "type": "string", "minLength": 2 },
          "secondary_roles": { "type": "array", "items": { "type": "string" } },
          "platforms": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "languages": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "build_models": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": [
                "extend-host",
                "configure-host",
                "source-fork",
                "source-component-reuse",
                "embedded-engine",
                "ui-shell-migration",
                "reference-inspired-ui",
                "multi-engine-composition",
                "worker-service",
                "custom-component",
                "custom-engine"
              ]
            }
          },
          "integration_patterns": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": [
                "static-lib",
                "shared-lib",
                "c-abi",
                "python-binding",
                "dotnet-interop",
                "jni",
                "js-bridge",
                "wasm",
                "cli-ipc",
                "service-api",
                "reference-only"
              ]
            }
          },
          "capabilities": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": ["support_state", "confidence_grade", "evidence_refs"],
              "properties": {
                "support_state": {
                  "type": "string",
                  "enum": [
                    "unknown",
                    "unsupported",
                    "documented",
                    "extension-required",
                    "external-component-required",
                    "experimentally-tested",
                    "verified-for-target"
                  ]
                },
                "confidence_grade": {
                  "type": "string",
                  "enum": [
                    "unresolved",
                    "documented",
                    "source-inspected",
                    "compiled",
                    "runtime-observed",
                    "target-verified",
                    "rejected"
                  ]
                },
                "evidence_refs": { "type": "array", "items": { "type": "string" } },
                "notes": { "type": "string" }
              }
            }
          },
          "relationships": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type", "target_id", "notes"],
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "provides",
                    "requires",
                    "wraps",
                    "binds",
                    "extends",
                    "replaces",
                    "conflicts",
                    "compatible-with",
                    "tested-with",
                    "alternative-to",
                    "reference-only"
                  ]
                },
                "target_id": { "type": "string", "minLength": 2 },
                "version_constraint": { "type": "string" },
                "abi_or_host": { "type": "string" },
                "notes": { "type": "string" }
              }
            }
          },
          "verification_metadata": {
            "type": "object",
            "required": [
              "trust_level",
              "official_url",
              "github_url",
              "supported_os",
              "primary_language",
              "license_status",
              "license_spdx_hint",
              "license_reviewed_on",
              "version_or_ref",
              "device_requirements",
              "api_key_or_billing",
              "offline_rights",
              "dependency_footprint",
              "security_status",
              "security_notes",
              "last_checked",
              "cost_classification",
              "host_dependency"
            ],
            "properties": {
              "trust_level": { "type": "string", "enum": ["V1", "V2", "V3", "RUN-VERIFIED"] },
              "official_url": { "type": "string" },
              "github_url": { "type": "string" },
              "supported_os": { "type": "array", "minItems": 1, "items": { "type": "string" } },
              "primary_language": { "type": "string" },
              "license_status": { "type": "string", "enum": ["verified-upstream", "verify-upstream", "commercial-terms"] },
              "license_spdx_hint": { "type": "string" },
              "license_reviewed_on": { "type": "string" },
              "version_or_ref": { "type": "string" },
              "device_requirements": { "type": "string" },
              "api_key_or_billing": { "type": "string" },
              "offline_rights": { "type": "string" },
              "dependency_footprint": { "type": "string" },
              "security_status": { "type": "string", "enum": ["reviewed-metadata-only", "quarantine-reference-only", "sast-verified", "commercial-uninspected"] },
              "security_notes": { "type": "string" },
              "last_checked": { "type": ["string", "null"] },
              "cost_classification": {
                "type": "string",
                "enum": [
                  "free-of-charge",
                  "open-source",
                  "source-available",
                  "free-tier",
                  "academic-only",
                  "non-commercial",
                  "commercial",
                  "trial",
                  "unknown"
                ]
              },
              "host_dependency": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
